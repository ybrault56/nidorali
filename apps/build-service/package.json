{
  "name": "@nidorali/build-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/server.ts src/worker.ts --format esm --dts --clean",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint . --config ../../packages/config/eslint/base.mjs --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nidorali/config": "workspace:*",
    "@nidorali/types": "workspace:*",
    "@supabase/supabase-js": "^2.49.1",
    "bullmq": "^5.43.0",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "resend": "^4.1.2",
    "sharp": "^0.33.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
